# Copy this file to `.env` and fill in your values.
#   cp .env.example .env

# Deployer wallet private key (64 hex chars, no 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs (used by Hardhat networks in hardhat.config.js)
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Block explorer API keys (contract verification via `npx hardhat verify`)
# Etherscan: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key
# BscScan: https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key

# Factory addresses after deploy (optional local record)
# Copy deployed values to your frontend `w3kit/.env` using the same key names.
TOKEN_FACTORY_CONTRACT_ADDRESS_BSC_TESTNET=
TOKEN_FACTORY_CONTRACT_ADDRESS_BSC_MAINNET=
TOKEN_FACTORY_CONTRACT_ADDRESS_ETH_SEPOLIA=
TOKEN_FACTORY_CONTRACT_ADDRESS_ETH_MAINNET=
